{
  "manifest_version": 3,
  "name": "Recap",
  "version": "0.2.0",
  "description": "Captures live captions from Google Meet, Zoom, and Microsoft Teams and sends them to the Recap Mac app.",
  "key": "",
  "permissions": ["storage", "sidePanel", "nativeMessaging"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://app.zoom.us/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["core.js", "adapters/meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.zoom.us/wc/*", "https://*.zoom.us/wc/*"],
      "js": ["core.js", "adapters/zoom.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["core.js", "adapters/teams.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Recap"
  },
  "options_page": "options.html"
}
